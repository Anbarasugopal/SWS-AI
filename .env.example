PDF_DIR=./data/pdfs
QDRANT_DIR=./storage/qdrant
COLLECTION_NAME=sws_ai_documents
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_K=4

# LLM_PROVIDER can be auto, openai, anthropic, ollama, or extractive.
# auto picks OpenAI if OPENAI_API_KEY exists, then Anthropic, then Ollama if requested,
# and finally a local extractive fallback for demos without an API key.
LLM_PROVIDER=auto
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
